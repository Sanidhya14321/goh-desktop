diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -42,13 +42,18 @@
         env:
           GH_TOKEN: ${{ github.token }}
         run: |
           files=$(find dist -maxdepth 1 -type f | sort)
-          gh release create "$GITHUB_REF_NAME" $files --title "GoHarness ${GITHUB_REF_NAME#v}" --notes-file notes.md --latest --verify-tag
+          if [[ "$GITHUB_REF_NAME" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
+            channel=(--latest)
+          else
+            channel=(--prerelease --latest=false)
+          fi
+          gh release create "$GITHUB_REF_NAME" $files --title "GoHarness ${GITHUB_REF_NAME#v}" --notes-file notes.md "${channel[@]}" --verify-tag
       - name: Package manager manifests
         # Stable versions only, so `brew upgrade` and `scoop update` never
